### stitch/stitch.css
71a72,125
> 
> /* Approved finishing requirements: regular navigation, readable captions,
>    keyboard project entry and room for the map between header and caption. */
> .stitch .topbar { position: fixed; inset: 0 0 auto; z-index: 4; min-height: 60px; padding: 14px 24px; display: flex; align-items: center; justify-content: space-between; gap: 18px; background: var(--st-glass); border-bottom: 1px solid var(--st-line); backdrop-filter: blur(10px); }
> .stitch .topbar a { text-decoration: none; font-size: 14px; }
> .stitch .topbar .brand { font-family: var(--st-serif); font-size: 20px; white-space: nowrap; }
> .stitch .topbar nav { display: flex; flex-wrap: wrap; gap: 20px; }
> .stitch .gl { top: var(--header-height, 64px); height: max(160px, calc(100dvh - var(--header-height, 64px) - var(--caption-height, 190px))); }
> .stitch .cap { bottom: 12px; left: 24px; max-width: 540px; max-height: 42dvh; overflow: auto; padding: 12px 16px; }
> .stitch .cap h2 { font-size: 23px; }
> .stitch .proof { margin-top: 8px !important; font-size: 13px !important; }
> .stitch .tools { margin-top: 8px !important; font-size: 13px !important; }
> .stitch .hint { bottom: 14px; right: 28px; left: auto; transform: none; }
> .stitch .rail a { pointer-events: auto; display: flex; align-items: center; justify-content: flex-end; gap: 10px; flex-direction: row-reverse; min-height: 32px; padding: 3px 4px; text-decoration: none; font: 500 13px var(--st-sans); color: var(--st-muted); text-shadow: 0 0 6px var(--st-bg), 0 0 12px var(--st-bg); }
> .stitch .rail a.on { color: var(--st-ink); }
> .stitch .rail a.on i { background: var(--st-amber); opacity: 1; transform: scale(1.4); }
> .stitch .rail { top: 42%; }
> .stitch a:focus-visible, .stitch button:focus-visible { outline: 3px solid var(--st-amber); outline-offset: 3px; }
> .stitch .project-links { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
> .stitch .project-links button, .stitch .actions a { border: 1px solid var(--st-line); border-radius: 6px; padding: 8px 10px; min-height: 38px; color: var(--st-ink); background: var(--st-bg); font: 500 13px var(--st-sans); cursor: pointer; text-decoration: none; }
> .stitch .actions { display: flex; gap: 8px; margin-top: 12px; }
> .stitch .actions a:first-child { background: var(--st-amber); color: #11161c; }
> .stitch dialog.modal { width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; border: 0; }
> .stitch dialog.modal:not([open]) { display: none; }
> .stitch dialog.modal::backdrop { background: rgba(5,7,10,.65); }
> .stitch .modal .sheet { max-height: calc(100dvh - 32px); }
> .stitch .modal [data-close] { width: 44px; height: 44px; }
> .stitch .text { padding-top: 92px; }
> .stitch .text article { scroll-margin-top: 84px; }
> .stitch[data-scene="off"] .topbar { position: sticky; }
> .stitch[data-scene="off"] .text { padding-top: 30px; }
> @media (max-width: 720px) {
>   .stitch .topbar { padding: 10px 12px; gap: 8px; min-height: 64px; }
>   .stitch .topbar .brand { font-size: 17px; }
>   .stitch .topbar nav { column-gap: 12px; row-gap: 4px; justify-content: flex-end; }
>   .stitch .topbar a { font-size: 12px; min-height: 24px; display: inline-flex; align-items: center; }
>   .stitch .cap { left: 12px; right: 12px; bottom: 12px; max-width: none; }
>   .stitch .cap h2 { font-size: 20px; }
>   .stitch .rail { right: 1px; }
