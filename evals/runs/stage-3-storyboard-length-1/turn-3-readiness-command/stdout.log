              "command": "/bin/bash -lc \"cat > scripts/local-only.mjs <<'EOF'\n// Next development mode checks the npm registry for version freshness.\n// Keep the local preview offline by rejecting non-loopback fetches before I/O.\nconst originalFetch=globalThis.fetch;\nglobalThis.fetch=(input,init)=>{\n const url=new URL(typeof input==='string'||input instanceof URL?input:input.url);\n if(\"'!['\"'127.0.0.1','localhost','[::1]'].includes(url.hostname))return Promise.reject(new Error('Local preview permits loopback fetches only'));\n return originalFetch(input,init);\n};\nEOF\nNODE_OPTIONS='--import ./scripts/local-only.mjs' NEXT_IGNORE_INCORRECT_LOCKFILE=1 PLAYWRIGHT_BROWSERS_PATH=/tmp/storyfolio-browser-cache LD_LIBRARY_PATH=/tmp/storyfolio-browser-libs/root/usr/lib/x86_64-linux-gnu node scripts/preview-concepts.mjs\"",
