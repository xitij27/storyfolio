  "sourceReview": {
    "path": "evals/lib/build-capture.mjs",
    "sha256": "7472bf42a1bfc2a18c7b317e9c1b43274e431737a6ea82f9e66c927a4b39521e",
    "disposition": "No remaining blocker found in the reviewed modality patch. Later full unit/integration verification and owner after-2 target-negative browser study remain separate.",
    "checks": [
      "Coordinator-owned schema-2 declaration required, exact selector/name/href and anchor tag match; actor CSS/data labels grant no authority.",
      "Declared hidden or disabled links remain inventoried; missing and duplicate declaration/inventory matches fail.",
      "Unfocused original geometry/hash and pointer not-applicable record are distinct from successful activation; ordinary controls retain pointer and keyboard requirements.",
      "Focused original screenshots, geometry, real sequential Tab, and actual declared fragment response are required.",
      "Owner's follow-up requires visible unique target with two-dimensional viewport intersection; reviewed source and tests, not claiming after-2 browser results here."
    ]
  },
  "observations": [
    {
      "variants": [
        "blocked-tab",
        "hidden",
        "negative-tab"
      ],
      "observation": "Entry and unfocused originals show no skip control; no focused/after originals were produced. Saved failure records correctly retain failed keyboard reachability, not a waived pass."
    },
    {
      "variants": [
        "covered-ordinary",
        "occluded"
      ],
      "observation": "Opaque red block covers the skip region before keyboard activation. Destination later appears despite the covered control; successful navigation does not erase the control visibility/hit-target failure."
    },
    {
      "variants": [
        "disabled"
      ],
      "observation": "Keyboard before/after originals visibly reveal the skip and answer, but disabled semantics are only in the recorded DOM evidence. Checker correctly fails despite those apparently successful pictures."
    },
    {
      "variants": [
        "forged-metadata",
        "mismatched-declaration",
        "undeclared"
      ],
      "observation": "Focused skip and answer originals show keyboard navigation can work. That is insufficient authority for a pointer exception; saved records correctly retain ordinary pointer/declaration failures."
    },
    {
      "variants": [
        "missing-target"
      ],
      "observation": "Keyboard after remains on the entry view with the focused skip, consistent with no valid destination response."
    },
    {
      "variants": [
        "offscreen-button"
      ],
      "observation": "Keyboard before/after show a small focused button and unchanged entry page. It is not an authorized bypass anchor, so pointer failure remains."
    },
    {
      "variants": [
        "wrong-destination"
      ],
      "observation": "Keyboard after shows A different target instead of The answer target; declaration mismatch remains a failure."
    }
  ],
