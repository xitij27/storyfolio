{
  "name": "storyfolio-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"lib/**/*.test.ts\" \"scripts/*.test.mjs\" \"components/story/*.test.ts\" \"stitch/*.test.ts\"",
    "check": "node scripts/site-check.mjs",
    "check:plain": "node scripts/check.mjs",
    "browsers": "playwright-core install chromium"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.180.0",
    "@react-three/fiber": "9.6.1"
  },
  "devDependencies": {
    "tailwindcss": "4.3.2",
    "@tailwindcss/postcss": "4.3.2",
    "typescript": "5.9.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "@types/three": "0.180.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.20.5",
    "playwright-core": "1.64.0"
  }
}
